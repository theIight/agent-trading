# Agent phân tích được bật (chọn trên UI): claude-code, agy (Antigravity CLI)
AGENT_RUNNERS=claude-code,agy
# Agent mặc định
AGENT_RUNNER=claude-code
CLAUDE_BIN=claude
# Rỗng = model mặc định của Claude Code
AGENT_MODEL=
AGY_BIN=agy
# Model mặc định cho agy (xem `agy models`); rỗng = mặc định của agy
AGY_MODEL=gemini-4-argon-high
AGY_TIMEOUT_MS=600000
AGENT_TIMEOUT_MS=300000
# R:R tối thiểu của trade setup (giữa vùng entry → TP xa nhất)
SETUP_MIN_RR=2

# Nguồn XAUUSD: tiingo-okx (giá Tiingo + volume OKX XAU-USDT-SWAP) | oanda | binance (XAUUSDT)
XAUUSD_SOURCE=tiingo-okx
# Tiingo: tiingo.com → Account → API → Token. Gói miễn phí 50 request/giờ. Không commit token.
TIINGO_API_TOKEN=
TIINGO_XAU_TICKER=xauusd
TIINGO_MAX_PER_HOUR=45
TIINGO_MAX_PER_DAY=950
OKX_VOLUME_INST=XAU-USDT-SWAP

# OANDA v20 cho XAUUSD (giá vàng giao ngay). Lấy token: OANDA Hub → Manage API Access. Không commit token.
OANDA_API_TOKEN=
# practice (tài khoản demo) | live
OANDA_ENV=practice
# M = mid, B = bid, A = ask
OANDA_PRICE=M
# Symbol lấy từ OANDA (còn lại lấy từ Binance)
OANDA_SYMBOLS=XAUUSD
LIVE_POLL_MS=2000

# Dữ liệu thị trường
MARKET_PROVIDER=binance-futures
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_TF=4h
SUPPORTED_TFS=1m,5m,15m,30m,1h,4h,1d,1w
# Preset khung phụ mặc định cho khung chính 4h
DEFAULT_CONTEXT_TFS=1d,5m
# Tổng số khung (chính + phụ) tối đa mỗi lần phân tích
AGENT_MAX_TFS=4
AGENT_BARS_PER_TF=300

# Server (local trước; VPS đổi HOST sau)
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/app.db

# Bookmap (order flow): đường dẫn ảnh Bookmap ghi ra (symbol có path mới dùng được), offset = giá Bookmap − giá app
# (vàng: GC futures − spot), ngưỡng cảnh báo ảnh cũ
# BOOKMAP_IMAGE_XAUUSD_HTF=~/ssd/live3.png
# BOOKMAP_IMAGE_XAUUSD_LTF=~/ssd/live4.png
# BOOKMAP_IMAGE_BTCUSDT_HTF=~/ssd/live1.png
# BOOKMAP_IMAGE_BTCUSDT_LTF=~/ssd/live2.png
# BOOKMAP_OFFSET_XAUUSD=10
# BOOKMAP_OFFSET_BTCUSDT=0
# BOOKMAP_TOLERANCE_XAUUSD=3
# BOOKMAP_TOLERANCE_BTCUSDT=60
# BOOKMAP_MAX_AGE_MIN=30

# Order flow Binance spot (server tự ghi sổ lệnh qua WebSocket, thay ảnh Bookmap cho các symbol này; rỗng = tắt)
# ORDERFLOW_BINANCE_SYMBOLS=BTCUSDT,XAUUSD
# Nguồn Binance của symbol chart: spot|futures:<SYMBOL>
# ORDERFLOW_SOURCE_XAUUSD=futures:XAUUSDT
# ORDERFLOW_BUCKET_XAUUSD=1
# ORDERFLOW_BIG_TRADE_XAUUSD=80
# ORDERFLOW_ABSORB_XAUUSD=300
# ORDERFLOW_WALL_MIN_XAUUSD=500
# ORDERFLOW_OFFSET_XAUUSD=0
# ORDERFLOW_RESYNC_MIN_XAUUSD=5
# ORDERFLOW_BUCKET_BTCUSDT=10
# ORDERFLOW_BIG_TRADE_BTCUSDT=1
# ORDERFLOW_ABSORB_BTCUSDT=8
# Khối lượng tối thiểu để tính là tường trong lịch sử tường trên chart
# ORDERFLOW_WALL_MIN_BTCUSDT=8
# Offset dự phòng giá spot − giá chart (futures) khi chưa tính được basis (trung vị 60 phút spot − futures)
# ORDERFLOW_OFFSET_BTCUSDT=33
# ORDERFLOW_SAMPLE_SEC=10
# Volume gộp (nến đã đóng): perp Binance Futures + OKX + Bybit, spot Binance. Rỗng = tắt.
# VOLAGG_SYMBOLS=BTCUSDT
# VOLAGG_SPIKE_X=3
# Thanh lý (bong bóng thật Binance + OKX, heatmap ước tính từ OI Binance). Rỗng = tắt.
# LIQ_SYMBOLS=BTCUSDT
# LIQ_OKX_INST_BTCUSDT=BTC-USDT-SWAP:0.01
# LIQ_MIN_QTY_BTCUSDT=0.5
# LIQ_BUCKET_BTCUSDT=50
# LIQ_LEVERAGE=10:0.3,25:0.3,50:0.25,100:0.15
# LIQ_MMR=0.004
# LIQ_RETAIN_H=72
# ORDERFLOW_RETAIN_H=24
# ORDERFLOW_RESYNC_MIN=30
# Telegram: khi phân tích kết thúc, server chụp chart (Chrome headless mở trang ?snapshot=) và gửi vào chat. Thiếu token/chat id = tắt.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_THREAD_ID=          # topic trong group bật chủ đề (message_thread_id)
# TELEGRAM_TFS=all            # all | primary
# TELEGRAM_NOTIFY_FAILED=1     # 0 = không báo phân tích lỗi
# TELEGRAM_BOT_COMMANDS=1      # 0 = chỉ gửi một chiều, không nhận lệnh /analyze trong group
# TELEGRAM_ALLOWED_CHATS=      # chat id thêm được ra lệnh (ngoài TELEGRAM_CHAT_ID), phân cách dấu phẩy
# TELEGRAM_ALLOWED_USERS=      # giới hạn user id được ra lệnh; rỗng = mọi thành viên chat
# TELEGRAM_BOT_DEFAULT_TF=4h   # khung chính khi /analyze không nêu khung
# TELEGRAM_BOT_DEFAULT_CONTEXT=1d,1h,1m
# TELEGRAM_BOT_MAX_PENDING=2   # phân tích bot tạo đang chờ/chạy tối đa mỗi chat
# SNAPSHOT_WEB_URL=http://127.0.0.1:5173
# Alert chạm vùng entry của setup (crypto, phân tích mới nhất mỗi symbol), báo Telegram một lần
# PRICE_ALERTS=1               # 0 = tắt
# PRICE_ALERT_MAX_AGE_H=72     # hạn alert khi setup không có validUntil (giờ)
# SNAPSHOT_CHROME_CHANNEL=chrome   # rỗng = Chromium của Playwright
