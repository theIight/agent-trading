# Agent phân tích được bật (chọn trên UI): claude-code, agy (Antigravity CLI)
AGENT_RUNNERS=claude-code,agy
# Agent mặc định
AGENT_RUNNER=claude-code
CLAUDE_BIN=claude
# Rỗng = model mặc định của Claude Code
AGENT_MODEL=
AGY_BIN=agy
# Model mặc định cho agy (xem `agy models`); rỗng = mặc định của agy
AGY_MODEL=gemini-4-argon-high
AGY_TIMEOUT_MS=600000
AGENT_TIMEOUT_MS=300000
# R:R tối thiểu của trade setup (giữa vùng entry → TP xa nhất)
SETUP_MIN_RR=2

# Nguồn XAUUSD: tiingo-okx (giá Tiingo + volume OKX XAU-USDT-SWAP) | oanda | binance (XAUUSDT)
XAUUSD_SOURCE=tiingo-okx
# Tiingo: tiingo.com → Account → API → Token. Gói miễn phí 50 request/giờ. Không commit token.
TIINGO_API_TOKEN=
TIINGO_XAU_TICKER=xauusd
TIINGO_MAX_PER_HOUR=45
TIINGO_MAX_PER_DAY=950
OKX_VOLUME_INST=XAU-USDT-SWAP

# OANDA v20 cho XAUUSD (giá vàng giao ngay). Lấy token: OANDA Hub → Manage API Access. Không commit token.
OANDA_API_TOKEN=
# practice (tài khoản demo) | live
OANDA_ENV=practice
# M = mid, B = bid, A = ask
OANDA_PRICE=M
# Symbol lấy từ OANDA (còn lại lấy từ Binance)
OANDA_SYMBOLS=XAUUSD
LIVE_POLL_MS=2000

# Dữ liệu thị trường
MARKET_PROVIDER=binance-futures
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_TF=4h
SUPPORTED_TFS=1m,5m,15m,30m,1h,4h,1d,1w
# Preset khung phụ mặc định cho khung chính 4h
DEFAULT_CONTEXT_TFS=1d,5m
# Tổng số khung (chính + phụ) tối đa mỗi lần phân tích
AGENT_MAX_TFS=4
AGENT_BARS_PER_TF=300

# Server (local trước; VPS đổi HOST sau)
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/app.db

# Bookmap (order flow): symbol nhận ảnh, offset = giá Bookmap − giá app (vàng: GC futures − spot), ngưỡng cảnh báo ảnh cũ
# BOOKMAP_SYMBOLS=XAUUSD,BTCUSDT
# BOOKMAP_OFFSET_XAUUSD=10
# BOOKMAP_OFFSET_BTCUSDT=0
# BOOKMAP_TOLERANCE_XAUUSD=3
# BOOKMAP_TOLERANCE_BTCUSDT=60
# BOOKMAP_MAX_AGE_MIN=30
